# Copia este archivo a .env (raíz del repo) y ajusta los valores.
# docker compose lo lee automáticamente; si no existe, se usan los
# valores por defecto declarados en docker-compose.yml.

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=3000
APP_ENV=dev
NODE_ENV=production

# Cadena local del postgres del propio compose (host: postgres, no localhost).
DATABASE_URL=postgresql://postgres:password@postgres:5432/barberias_test?schema=public

# Cadena local del redis del propio compose.
REDIS_URL=redis://redis:6379

# Cámbialo en cuanto publiques algo que no sea local.
JWT_SECRET=dev-secret-cambiar-en-produccion

# Origen de la SPA para CORS (nginx del compose).
FRONTEND_URL=http://localhost:8080

# Notificaciones (opcionales: sin ellas se usan los mocks).
RESEND_API_KEY=
EMAIL_FROM=no-reply@barberias.test
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=8080