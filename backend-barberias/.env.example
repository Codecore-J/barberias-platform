# Cadena de conexión PostgreSQL (ej. Neon con SSL o instancia local)
DATABASE_URL="postgresql://usuario_ejemplo:password_falsa@localhost:5432/barberias_db?schema=public"

# Secreto criptográfico para firma y verificación de tokens JWT
JWT_SECRET="secreto_jwt_ejemplo_no_usar_en_produccion_min_32_caracteres"

# Puerto HTTP en el que escuchará el servidor NestJS
PORT=3000

# URL de la aplicación frontend permitida en CORS
FRONTEND_URL="http://localhost:4200"

# URL de conexión a Redis para BullMQ (ej. Upstash o Redis local)
REDIS_URL="redis://default:password_falsa@localhost:6379"

# Host de Redis (usado si no se proporciona REDIS_URL directa)
REDIS_HOST="127.0.0.1"

# Puerto de conexión de Redis
REDIS_PORT=6379

# Entorno estándar de ejecución de Node.js (development, production, test)
NODE_ENV="development"

# Entorno lógico de la plataforma según D11 (dev, staging, production)
APP_ENV="dev"

# Tamaño del threadpool de libuv para optimizar I/O y bcrypt (PERF-01)
UV_THREADPOOL_SIZE=16

# Activar logs de consultas Prisma en desarrollo (true o false)
DEBUG_PRISMA="false"
