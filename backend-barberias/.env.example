# Cadena de conexión PostgreSQL (ej. Neon con SSL o instancia local)
DATABASE_URL="postgresql://usuario_ejemplo:password_falsa@localhost:5432/barberias_db?schema=public"

# Secreto criptográfico para firma y verificación de tokens JWT
JWT_SECRET="secreto_jwt_ejemplo_no_usar_en_produccion_min_32_caracteres"

# Puerto HTTP en el que escuchará el servidor NestJS
PORT=3000

# URL de la aplicación frontend permitida en CORS
FRONTEND_URL="http://localhost:4200"

# URL de conexión a Redis para BullMQ (ej. Upstash o Redis local)
REDIS_URL="redis://default:password_falsa@localhost:6379"

# Host de Redis (usado si no se proporciona REDIS_URL directa)
REDIS_HOST="127.0.0.1"

# Puerto de conexión de Redis
REDIS_PORT=6379

# Entorno estándar de ejecución de Node.js (development, production, test)
NODE_ENV="development"

# Entorno lógico de la plataforma según D11 (dev, staging, production)
APP_ENV="dev"

# Tamaño del threadpool de libuv para optimizar I/O y bcrypt (PERF-01)
UV_THREADPOOL_SIZE=16

# Activar logs de consultas Prisma en desarrollo (true o false)
DEBUG_PRISMA="false"

# ---------------------------------------------------------------------------
# Fase 7 · Notificaciones (OPCIONALES)
# Todas son opcionales: sin ellas el módulo arranca con los adaptadores Mock
# que solo escriben en el log. Con ellas salen los envíos reales.
# ---------------------------------------------------------------------------

# API key de Resend (https://resend.com/api-keys). Su presencia enciende
# ResendEmailProvider; sin ella se usa MockEmailProvider.
# RESEND_API_KEY="re_123..."

# Remitente verificado en Resend. Requerido si se usa RESEND_API_KEY.
# EMAIL_FROM="Barberias <no-reply@tudominio.com>"

# Endpoint del proveedor de WhatsApp (Meta Cloud API o un gateway tipo
# Evolution API) y su token. Ambas son necesarias para encender
# HttpWhatsAppProvider; si falta alguna, se usa MockWhatsAppProvider.
# WHATSAPP_API_URL="https://graph.facebook.com/v20.0/PHONE_NUMBER_ID/messages"
# WHATSAPP_API_TOKEN="EAAG..."

# Secreto compartido que valida el header x-webhook-secret del webhook
# POST /webhooks/whatsapp. Sin esta variable el endpoint responde 503.
# WHATSAPP_WEBHOOK_SECRET="un_secreto_largo_y_aleatorio"
