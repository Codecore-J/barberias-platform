/// V3 fase 5 · horario semanal propio del barbero dentro de una sede.
///
/// `dia_semana` sigue la convención ISO que ya usa TODO el motor: 1 = lunes …
/// 7 = domingo (`TiempoService.diaSemana` devuelve el `weekday` de Luxon). Cambiarla
/// a 0 = domingo obligaría a reescribir horarios, excepciones y agenda.
///
/// El motor de disponibilidad INTERSECTA este horario con el de la sede: el
/// rango efectivo es el más restrictivo de los dos. Si el barbero no tiene
/// ninguna fila en la sede se hereda el horario de la sede (retrocompatible);
/// si tiene filas, los días sin fila quedan libres.
///
/// `hora_inicio`/`hora_fin` son nulos solo en un día libre. Los descansos son
/// opcionales y viven dentro de la jornada; el CHECK de la migración lo impone
/// además de la validación del DTO.
model HorarioBarbero {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId         String    @map("barberia_id") @db.Uuid
  barberoId          String    @map("barbero_id") @db.Uuid
  diaSemana          Int       @map("dia_semana") @db.SmallInt
  horaInicio         DateTime? @map("hora_inicio") @db.Time
  horaFin            DateTime? @map("hora_fin") @db.Time
  horaInicioDescanso DateTime? @map("hora_inicio_descanso") @db.Time
  horaFinDescanso    DateTime? @map("hora_fin_descanso") @db.Time
  esDiaLibre         Boolean   @default(false) @map("es_dia_libre")

  barberia Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  barbero  Usuario  @relation("HorarioDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)

  @@unique([barberiaId, barberoId, diaSemana], name: "uk_horario_barbero_dia", map: "uk_horario_barbero_dia")
  @@map("horarios_barbero")
}

model ExcepcionHorarioBarbero {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId      String                    @map("barberia_id") @db.Uuid
  barberoId       String                    @map("barbero_id") @db.Uuid
  fecha           DateTime                  @db.Date
  tipo            String                    @db.VarChar(20)
  horaInicio      DateTime?                 @map("hora_inicio") @db.Time
  horaFin         DateTime?                 @map("hora_fin") @db.Time
  motivo          String?                   @db.Text
  // V3 · autoría del cambio. `modificadoPor` dice el ORIGEN (el propio barbero
  // o un administrador de la sede) y `modificadoPorId` el usuario concreto.
  // El id es opcional porque las filas anteriores a esta migración no lo
  // tienen: se prefiere un autor desconocido a inventar uno.
  modificadoPor   OrigenModificacionHorario @default(BARBERO) @map("modificado_por")
  modificadoPorId String?                   @map("modificado_por_id") @db.Uuid

  barberia    Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  barbero     Usuario  @relation("ExcepcionDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)
  // Borrar al autor deja la excepción SIN autor, no sin fila.
  modificador Usuario? @relation("ExcepcionModificadaPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)

  @@unique([barberoId, barberiaId, fecha], name: "uk_excepcion_barbero_fecha")
  @@map("excepciones_horario_barbero")
}

/// V3 · plantilla semanal recurrente del barbero.
///
/// Es el horario BASE sin sede: la plantilla de la semana que el barbero
/// declara una vez. `HorarioBarbero` sigue siendo el horario efectivo dentro
/// de cada sede y es el único que lee hoy el motor de disponibilidad; esta
/// tabla no se materializa en la sede todavía.
///
/// `diaSemana` usa la MISMA numeración que el resto del motor (ISO 1 = lunes …
/// 7 = domingo), que es la de `HorarioBarbero`, `Horario` y
/// `TiempoService.diaSemana`. Compartir la convención evita que una lectura
/// cruzada entre la plantilla y el horario de la sede desplace la semana un
/// día; el CHECK de la migración acota el rango a 1–7.
///
/// Las horas son texto "HH:mm", no `TIME`: son horas de reloj sin fecha ni
/// zona. El CHECK de la migración valida el formato y que el inicio sea
/// anterior al fin.
///
/// La unicidad es `(barbero, día)` SIN sede: un barbero que trabaje en varias
/// sedes comparte plantilla. Un horario distinto por sede vive en
/// `HorarioBarbero`, no aquí.
model HorarioBaseBarbero {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberoId  String  @map("barbero_id") @db.Uuid
  diaSemana  Int     @map("dia_semana") @db.SmallInt
  horaInicio String  @map("hora_inicio") @db.VarChar(5)
  horaFin    String  @map("hora_fin") @db.VarChar(5)
  activo     Boolean @default(true)

  barbero Usuario @relation("HorarioBaseDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)

  @@unique([barberoId, diaSemana], map: "uk_horario_base_barbero_dia")
  @@map("horarios_base_barbero")
}

/// F4-03 · propuesta de cambio de la plantilla base de un barbero en una sede.
///
/// La decisión 9 del dueño (22 nov 2026) separó PROPONER de APLICAR: el barbero
/// ya no escribe `horarios_base_barbero` con el `PUT` de su plantilla, deja una
/// propuesta `PENDIENTE` y el ADMIN_BARBERIA la resuelve (F4-04).
///
/// `dias` es la semana COMPLETA propuesta —siete filas con `diaSemana`,
/// `horaInicio`, `horaFin` y `activo`—, no solo los días del último envío:
/// aprobar aplica la propuesta entera y así no queda una decisión a medias. Se
/// guarda como JSON porque es un documento de la propuesta y no participa en
/// ninguna consulta por día; la plantilla vigente sí vive normalizada.
///
/// El índice único PARCIAL «una sola PENDIENTE por barbero y sede» vive en la
/// migración (`uk_propuesta_base_pendiente`), igual que los CHECK de estado y de
/// motivo: Prisma no sabe expresarlos.
model PropuestaHorarioBase {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId    String    @map("barberia_id") @db.Uuid
  barberoId     String    @map("barbero_id") @db.Uuid
  estado        String    @default("PENDIENTE") @db.VarChar(20)
  dias          Json      @db.JsonB
  motivoRechazo String?   @map("motivo_rechazo") @db.VarChar(500)
  resueltoPor   String?   @map("resuelto_por") @db.Uuid
  resueltaAt    DateTime? @map("resuelta_at") @db.Timestamptz
  creadoAt      DateTime  @default(now()) @map("creado_at") @db.Timestamptz
  actualizadoAt DateTime  @default(now()) @updatedAt @map("actualizado_at") @db.Timestamptz

  barberia  Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  barbero   Usuario  @relation("PropuestaBaseDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)
  resolutor Usuario? @relation("PropuestaBaseResueltaPor", fields: [resueltoPor], references: [id], onDelete: SetNull)

  @@index([barberiaId, estado], name: "idx_propuestas_base_sede_estado")
  @@map("propuestas_horario_base")
}

model BloqueosAgenda {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId String    @map("barberia_id") @db.Uuid
  barberoId  String?   @map("barbero_id") @db.Uuid
  fecha      DateTime  @db.Date
  horaInicio DateTime  @map("hora_inicio") @db.Time
  horaFin    DateTime  @map("hora_fin") @db.Time
  motivo     String?   @db.Text
  jobId      String?   @map("job_id") @db.VarChar(100)
  // E2-07 · D29: un bloqueo no se BORRA, se LIBERA. `liberado_at` marca el
  // instante (UTC) en que dejó de ocupar agenda; la fila se conserva para la
  // auditoría y la disponibilidad ignora los liberados. NULL = sigue ocupando.
  liberadoAt DateTime? @map("liberado_at") @db.Timestamptz
  creadoPor  String?   @map("creado_por") @db.Uuid
  creadoAt   DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  barberia Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  barbero  Usuario? @relation("BloqueoDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)
  creador  Usuario? @relation("BloqueoCreador", fields: [creadoPor], references: [id])

  @@map("bloqueos_agenda")
}

model Reserva {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId                 String    @map("barberia_id") @db.Uuid
  // F7 / T-72 · al eliminar una cuenta el historial de la sede se conserva: la
  // reserva deja de apuntar a la persona (SET NULL) pero mantiene su importe,
  // su servicio y su fecha. Antes era NOT NULL + RESTRICT y hacía imposible
  // borrar a cualquier usuario con historial.
  clienteId                  String?   @map("cliente_id") @db.Uuid
  // F3-01 · nombre que teclea el operador en un walk-in (cliente sin cuenta).
  // `cliente_id` sigue siendo el OPERADOR (T-05), así que el nombre visible de
  // la cita vive aquí; NULL en las reservas del propio cliente.
  nombreInvitado             String?   @map("nombre_invitado") @db.VarChar(150)
  barberoId                  String?   @map("barbero_id") @db.Uuid
  tipoReserva                String    @map("tipo_reserva") @db.VarChar(20)
  estado                     String    @default("PENDIENTE") @db.VarChar(30)
  modoConfirmacion           String    @map("modo_confirmacion") @db.VarChar(20)
  fechaCita                  DateTime  @map("fecha_cita") @db.Date
  horaInicio                 DateTime  @map("hora_inicio") @db.Time
  horaFin                    DateTime  @map("hora_fin") @db.Time
  margenGrupalHistorico      Int?      @map("margen_grupal_historico")
  totalPagar                 Decimal   @map("total_pagar") @db.Decimal(10, 2)
  expiraAt                   DateTime? @map("expira_at") @db.Timestamptz
  creadoAt                   DateTime? @default(now()) @map("creado_at") @db.Timestamptz
  // E3-09 · instante en que la reserva entró en COMPLETADA (§5.2 fila 11).
  // Nullable: solo lo escriben los cobros. Lo crea la migración reconstruida
  // `20261011130000_e203_integridad_base`; en `dev` ya existía (H50).
  completadaAt               DateTime? @map("completada_at") @db.Timestamptz
  // E3-04/D19: motivo estructurado del rechazo (§5.5). El CHECK del catálogo
  // vive en la migración; Prisma no sabe expresarlo.
  motivoCodigo               String?   @map("motivo_codigo") @db.VarChar(40)
  motivoDetalle              String?   @map("motivo_detalle") @db.Text
  // E3-08/D17 · cancelación especial: quién canceló, en qué estado quedó la
  // solicitud y con qué motivo del catálogo de cancelación (§5.5). Los CHECK
  // de estado y motivo viven en la migración.
  canceladoPorId             String?   @map("cancelado_por_id") @db.Uuid
  cancelacionEspecialEstado  String?   @map("cancelacion_especial_estado") @db.VarChar(20)
  cancelacionEspecialMotivo  String?   @map("cancelacion_especial_motivo") @db.VarChar(40)
  cancelacionEspecialDetalle String?   @map("cancelacion_especial_detalle") @db.Text
  // Fase 7 · recordatorio preventivo de no-show. El cron lo marca ANTES de
  // emitir `reserva.recordatorio`, y el `updateMany` condicionado a `false` es
  // lo que impide que dos ejecuciones solapadas (o dos instancias del API)
  // avisen dos veces de la misma cita.
  recordatorioEnviado        Boolean   @default(false) @map("recordatorio_enviado")

  barberia     Barberia @relation(fields: [barberiaId], references: [id])
  cliente      Usuario? @relation("ClienteReserva", fields: [clienteId], references: [id], onDelete: SetNull)
  barbero      Usuario? @relation("BarberoReserva", fields: [barberoId], references: [id], onDelete: SetNull)
  canceladoPor Usuario? @relation("CanceladoPorReserva", fields: [canceladoPorId], references: [id])

  participantes ParticipanteReserva[]
  propuestas    PropuestaHorario[]
  pago          Pago?

  @@index([barberiaId, fechaCita, estado, horaInicio, horaFin], name: "idx_reservas_concurrencia")
  // Fase 7 · lo usa el cron de recordatorios. Lo creó la migración
  // `add_recordatorio_flag` y no estaba declarado aquí, así que cada diff
  // proponía borrarlo (`DROP INDEX idx_reservas_recordatorio_pendiente`).
  @@index([fechaCita, estado, recordatorioEnviado], map: "idx_reservas_recordatorio_pendiente")
  // E0 · consultas calientes sin cobertura: "mis reservas" por cliente y la
  // agenda por barbero. Sin estos índices cada una es un Seq Scan con sort.
  @@index([clienteId])
  @@index([barberoId])
  // E0 · cron de expiración (`estado IN (...) AND expira_at <= now`): el índice
  // de concurrencia empieza por `barberia_id`, así que no lo podía resolver.
  @@index([estado, expiraAt])
  @@map("reservas")
}

/// E3-08/D18 · propuesta de un bloque horario nuevo para una reserva.
///
/// La crea el CLIENTE dueño (§5.4) y la resuelve el staff en una ventana de 10
/// minutos. A diferencia de D37, una propuesta PENDIENTE NO ocupa agenda: el
/// hueco propuesto se revalida y se toma solo al aceptarla.
model PropuestaHorario {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservaId  String    @map("reserva_id") @db.Uuid
  fechaCita  DateTime  @map("fecha_cita") @db.Date
  horaInicio DateTime  @map("hora_inicio") @db.Time
  horaFin    DateTime  @map("hora_fin") @db.Time
  tipo       String    @db.VarChar(30)
  estado     String    @default("PENDIENTE") @db.VarChar(20)
  expiraAt   DateTime? @map("expira_at") @db.Timestamptz
  creadoPor  String    @map("creado_por") @db.Uuid
  creadoAt   DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  creador Usuario @relation(fields: [creadoPor], references: [id])

  @@index([reservaId], name: "idx_propuestas_horario_reserva")
  @@map("propuestas_horario")
}

model ParticipanteReserva {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservaId           String  @map("reserva_id") @db.Uuid
  esAdultoResponsable Boolean @default(false) @map("es_adulto_responsable")
  nombreParticipante  String  @map("nombre_participante") @db.VarChar(150)

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  participanteServicios ParticipanteServicio[]

  @@map("participantes_reserva")
}

/// Snapshot financiero e histórico de UN servicio dentro de una reserva.
///
/// V3 fase 4 · el catálogo dejó de ser único: una fila apunta al `Servicio`
/// heredado (`servicio_id`) o al `ServicioBarbero` del catálogo híbrido
/// (`servicio_barbero_id`), nunca a los dos y nunca a ninguno. Las dos columnas
/// son opcionales en Prisma porque Postgres no sabe expresar «exactamente uno»
/// con `NOT NULL`; la regla vive en el CHECK
/// `participante_servicios_un_solo_servicio_check` de la migración.
///
/// El nombre, el precio y la duración se congelan aquí: desactivar el servicio
/// después (§9) no altera la reserva ya creada.
model ParticipanteServicio {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participanteId    String  @map("participante_id") @db.Uuid
  servicioId        String? @map("servicio_id") @db.Uuid
  servicioBarberoId String? @map("servicio_barbero_id") @db.Uuid
  precioHistorico   Decimal @map("precio_historico") @db.Decimal(10, 2)
  duracionHistorica Int     @map("duracion_historica")
  margenHistorico   Int     @map("margen_historico")

  participante    ParticipanteReserva @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  // RESTRICT explícito: coincide con la FK que creó `init`. Sin declararlo,
  // Prisma asume SET NULL para una relación opcional y su diff proponía
  // recrear la constraint cambiando la regla de borrado.
  servicio        Servicio?           @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  servicioBarbero ServicioBarbero?    @relation(fields: [servicioBarberoId], references: [id], onDelete: Restrict)

  @@index([servicioId], name: "idx_participante_servicios_servicio")
  @@index([servicioBarberoId], name: "idx_participante_servicios_barbero")
  @@map("participante_servicios")
}

model Pago {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservaId       String    @unique @map("reserva_id") @db.Uuid
  // V3 fase 6: la sede del cobro, copiada de la reserva en la misma
  // transacción. El arqueo diario filtra por ella y por `registrado_at`; sin
  // esta columna la caja tendría que unir `pagos` con `reservas` en cada
  // consulta.
  barberiaId      String    @map("barberia_id") @db.Uuid
  // H68: `ANULADO` es un estado del catálogo, no un borrado. El CHECK vive en la
  // migración `h68_anulacion_pagos`; Prisma no sabe expresarlo.
  estadoPago      String    @default("PENDIENTE_DE_PAGO") @map("estado_pago") @db.VarChar(20)
  monto           Decimal   @db.Decimal(10, 2)
  // H68: el método viaja en la fila porque el recibo de la sede lo muestra y la
  // auditoría no es un listado. `EN_PERSONA` es el valor histórico del cajero.
  metodoPago      String    @default("EN_PERSONA") @map("metodo_pago") @db.VarChar(30)
  registradoPor   String?   @map("registrado_por") @db.Uuid
  registradoAt    DateTime? @default(now()) @map("registrado_at") @db.Timestamptz
  actualizadoAt   DateTime? @map("actualizado_at") @db.Timestamptz
  // H68 · §7.3: rastro de la corrección EN LA FILA —quién, cuándo y por qué—,
  // además del evento `PAGO_ANULADO` que se escribe en la misma transacción.
  anuladoAt       DateTime? @map("anulado_at") @db.Timestamptz
  anuladoPor      String?   @map("anulado_por") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion") @db.Text
  // F7 / T-72 · nombre congelado de quien registró o anuló el cobro. Al
  // eliminar la cuenta el FK queda en NULL y esta columna conserva el rastro.
  usuarioNombreSnapshot String? @map("usuario_nombre_snapshot") @db.VarChar(150)

  reserva     Reserva  @relation(fields: [reservaId], references: [id])
  barberia    Barberia @relation(fields: [barberiaId], references: [id])
  registrador Usuario? @relation("RegistradoPor", fields: [registradoPor], references: [id])
  anulador    Usuario? @relation("AnuladoPorPago", fields: [anuladoPor], references: [id])

  @@index([barberiaId, registradoAt], name: "idx_pagos_barberia_fecha")
  @@map("pagos")
}

/// V3 fase 6 · cierre de caja diario de una sede.
///
/// Es una FOTO: los totales son los del día en que se ejecutó el cierre y no se
/// recalculan después. Un pago anulado más tarde ya no altera el arqueo porque
/// el arqueo dejó de mirar la tabla de pagos: guarda sus cifras.
///
/// `abierto_por` y `cerrado_por` son el mismo usuario en el flujo actual (no hay
/// apertura explícita de turno): se conservan los dos porque el contrato los
/// pide y porque permiten añadir la apertura sin migrar la tabla.
model CierreCaja {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId         String    @map("barberia_id") @db.Uuid
  /// Etiqueta de calendario (DATE) del día arqueado en la zona de la sede.
  fechaArqueo        DateTime  @map("fecha_arqueo") @db.Date
  totalEfectivo      Decimal   @default(0) @map("total_efectivo") @db.Decimal(12, 2)
  totalTarjeta       Decimal   @default(0) @map("total_tarjeta") @db.Decimal(12, 2)
  totalTransferencia Decimal   @default(0) @map("total_transferencia") @db.Decimal(12, 2)
  totalGeneral       Decimal   @default(0) @map("total_general") @db.Decimal(12, 2)
  estado             String    @default("CERRADO") @db.VarChar(20)
  abiertoPor         String?   @map("abierto_por") @db.Uuid
  cerradoPor         String?   @map("cerrado_por") @db.Uuid
  // F7 / T-72 · nombre congelado de quien abrió/cerró el arqueo; el FK se
  // desvincula al eliminar la cuenta y el arqueo sigue siendo legible.
  usuarioNombreSnapshot String? @map("usuario_nombre_snapshot") @db.VarChar(150)
  abiertoAt          DateTime? @map("abierto_at") @db.Timestamptz
  cerradoAt          DateTime? @map("cerrado_at") @db.Timestamptz
  creadoAt           DateTime  @default(now()) @map("creado_at") @db.Timestamptz

  barberia Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  abridor  Usuario? @relation("CierreAbiertoPor", fields: [abiertoPor], references: [id])
  cerrador Usuario? @relation("CierreCerradoPor", fields: [cerradoPor], references: [id])

  @@unique([barberiaId, fechaArqueo], name: "uk_cierre_caja_sede_fecha", map: "uk_cierre_caja_sede_fecha")
  @@index([barberiaId, fechaArqueo], name: "idx_cierre_caja_sede_fecha")
  @@map("cierres_caja")
}

model Antecedente {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  barberiaOrigenId String?   @map("barberia_origen_id") @db.Uuid
  categoria        String    @db.VarChar(50)
  contenido        String    @db.Text
  origen           String    @default("BARBERO") @db.VarChar(20)
  estadoValidacion String    @default("PENDIENTE") @map("estado_validacion") @db.VarChar(20)
  compartido       Boolean   @default(false)
  motivoRechazo    String?   @map("motivo_rechazo") @db.Text
  creadoAt         DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  barberiaOrigen Barberia? @relation("BarberiaOrigen", fields: [barberiaOrigenId], references: [id])

  @@map("antecedentes")
}

// F5 / T-51 · solicitud de antecedente.
//
// El personal de la sede (ADMIN_BARBERIA o BARBERO) ya no escribe directo en
// `antecedentes`: pide, y el ADMINISTRADOR global decide. La fila de
// `antecedentes` nace solo al aprobar, con `categoria = 'GENERAL'`,
// `contenido = motivo + evidencia` y `compartido = false`.
//
// `estado` es el ciclo de la PETICIÓN (PENDIENTE → APROBADA | DENEGADA) y no se
// borra: el historial de lo pedido y lo decidido se conserva. El índice único
// parcial impide dos PENDIENTES del mismo cliente en la misma sede; Prisma no
// expresa índices parciales, así que la garantía vive en la migración.
model SolicitudAntecedente {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId       String    @map("barberia_id") @db.Uuid
  solicitanteId    String    @map("solicitante_id") @db.Uuid
  clienteId        String    @map("cliente_id") @db.Uuid
  motivo           String    @db.Text
  evidenciaTexto   String?   @map("evidencia_texto") @db.Text
  estado           String    @default("PENDIENTE") @db.VarChar(20)
  resueltoPor      String?   @map("resuelto_por") @db.Uuid
  resueltoAt       DateTime? @map("resuelto_at") @db.Timestamptz
  motivoDenegacion String?   @map("motivo_denegacion") @db.Text
  creadoAt         DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  barberia    Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  solicitante Usuario  @relation("SolicitudAntecedenteSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  cliente     Usuario  @relation("SolicitudAntecedenteCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  // RESTRICT y no SET NULL: el CHECK exige `resuelto_por` cuando la solicitud
  // está resuelta, así que borrar al decidor dejaría la fila en un estado
  // imposible. Es un historial de seguridad: se conserva.
  resolutor   Usuario? @relation("SolicitudAntecedenteResolutor", fields: [resueltoPor], references: [id], onDelete: Restrict)

  @@index([clienteId, estado], name: "idx_solicitudes_antecedente_cliente_estado")
  @@index([barberiaId, estado], name: "idx_solicitudes_antecedente_sede_estado")
  @@map("solicitudes_antecedente")
}

model Notificacion {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  canal     String    @db.VarChar(20)
  tipo      String    @db.VarChar(50)
  contenido String?   @db.Text
  estado    String    @default("PENDIENTE") @db.VarChar(20)
  enviadoAt DateTime? @map("enviado_at") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // E0 · la bandeja consulta por usuario y filtra por estado; la tabla no tenía
  // ni un índice.
  @@index([usuarioId, estado])
  @@map("notificaciones")
}

model Auditoria {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String?   @map("usuario_id") @db.Uuid
  // E3-01 · A-15: la sede se guarda en COLUMNA, no solo en el JSON. La
  // migración `20261019120000_e0e1_auditoria_barberia_id` la añade y rellena
  // desde `contexto->>'barberiaId'` para no perder el histórico.
  barberiaId String?   @map("barberia_id") @db.Uuid
  accion     String    @db.VarChar(100)
  entidad    String    @db.VarChar(50)
  entidadId  String?   @map("entidad_id") @db.Uuid
  contexto   Json?
  creadoAt   DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])
  barberia Barberia? @relation(fields: [barberiaId], references: [id], onDelete: SetNull)

  @@index([barberiaId, creadoAt])
  @@map("auditoria")
}

model Reporte {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId   String?   @map("barberia_id") @db.Uuid
  tipo         String    @db.VarChar(50)
  estado       String    @default("PENDIENTE") @db.VarChar(20)
  referenciaId String?   @map("referencia_id") @db.Uuid
  descripcion  String?   @db.Text
  creadoAt     DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  barberia Barberia? @relation(fields: [barberiaId], references: [id])

  @@map("reportes")
}

model ConfiguracionBarberia {
  barberiaId                  String    @id @map("barberia_id") @db.Uuid
  modoReserva                 String    @default("MANUAL") @map("modo_reserva") @db.VarChar(20)
  aceptaIndividual            Boolean   @default(true) @map("acepta_individual")
  aceptaGrupal                Boolean   @default(true) @map("acepta_grupal")
  maxPendientes               Int?      @map("max_pendientes")
  maxNinos                    Int?      @map("max_ninos")
  maxPersonasTotal            Int?      @map("max_personas_total")
  horizonteReservaDias        Int?      @map("horizonte_reserva_dias")
  nuevasReservasActivas       Boolean   @default(true) @map("nuevas_reservas_activas")
  motivoPausa                 String?   @map("motivo_pausa") @db.Text
  pausaDesde                  DateTime? @map("pausa_desde") @db.Timestamptz
  reactivacionProgramada      DateTime? @map("reactivacion_programada") @db.Timestamptz
  reactivacionReal            DateTime? @map("reactivacion_real") @db.Timestamptz
  // D42 (2026-10-02): margen grupal propio de la barbería, default 10, rango 0-60.
  // Se snapshottea en reservas.margen_grupal_historico al crear (nunca suma ni DTO).
  margenGrupalMinutos         Int       @default(10) @map("margen_grupal_minutos")
  // D17: habilita la cancelación especial (fuera de la ventana de 30 min).
  // Por defecto FALSE: una sede no acepta cancelaciones especiales hasta que
  // lo activa explícitamente (E3-11 expondrá el PATCH de configuración).
  permiteCancelacionEspecial  Boolean   @default(false) @map("permite_cancelacion_especial")
  // E4-02/8 · D22: la sede puede apagar las oportunidades de espacio. Es la
  // bandera que gobierna el endpoint de huecos (GET .../disponibilidad/huecos):
  // con FALSE el endpoint responde 200 y la lista VACÍA, nunca 403.
  oportunidadesEspacioActivas Boolean   @default(true) @map("oportunidades_espacio_activas")

  barberia Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)

  @@map("configuracion_barberia")
}

/// E3-13 · D26: `solicitudes_cambio_barberia`.
///
/// El nombre de la sede y el responsable NO se editan directo: el ADMIN_BARBERIA
/// crea una solicitud y el ADMINISTRADOR la aprueba o la rechaza. `valor_nuevo`
/// guarda el nombre propuesto (tipo NOMBRE) o el uuid del usuario propuesto
/// (tipo RESPONSABLE).
model SolicitudCambioBarberia {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId    String    @map("barberia_id") @db.Uuid
  tipo          String    @db.VarChar(20)
  valorNuevo    String    @map("valor_nuevo") @db.VarChar(150)
  estado        String    @default("PENDIENTE") @db.VarChar(20)
  solicitadoPor String    @map("solicitado_por") @db.Uuid
  resueltoPor   String?   @map("resuelto_por") @db.Uuid
  motivoRechazo String?   @map("motivo_rechazo") @db.Text
  creadoAt      DateTime? @default(now()) @map("creado_at") @db.Timestamptz
  resueltoAt    DateTime? @map("resuelto_at") @db.Timestamptz

  barberia    Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  solicitante Usuario  @relation("SolicitudSolicitadaPor", fields: [solicitadoPor], references: [id], onDelete: Cascade)
  resolutor   Usuario? @relation("SolicitudResueltaPor", fields: [resueltoPor], references: [id], onDelete: SetNull)

  @@index([barberiaId, estado], name: "idx_solicitudes_cambio_sede_estado")
  @@map("solicitudes_cambio_barberia")
}

model TokenRecuperacion {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  usado     Boolean   @default(false)
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz
  creadoAt  DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tokenHash], name: "idx_tokens_recuperacion_hash")
  @@map("tokens_recuperacion")
}

/// E4-02 · D22: `lista_esperas` (Carril B).
///
/// Suscripción reactiva de un cliente a un hueco que se libere en ESA barbería
/// y fecha, para uno o varios servicios. Es el inverso de la reserva: el
/// cliente no toma agenda, deja dicho qué aceptaría.
///
/// `estado` es un catálogo cerrado —PENDIENTE → NOTIFICADO → CERRADO— y su
/// CHECK vive en la migración, igual que los de `reservas` y `pagos`: Prisma no
/// sabe expresar constraints de catálogo. Una suscripción nunca se BORRA, se
/// cierra (D29), así que no hay borrado que modelar aquí.
model ListaEspera {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  barberiaId    String    @map("barberia_id") @db.Uuid
  // Fecha deseada como ETIQUETA local de la sede (igual que `Reserva.fechaCita`),
  // no como instante UTC: el mismo día para cliente y sede.
  fechaObjetivo DateTime  @map("fecha_objetivo") @db.Date
  estado        String    @default("PENDIENTE") @db.VarChar(20)
  creadoAt      DateTime? @default(now()) @map("creado_at") @db.Timestamptz
  actualizadoAt DateTime? @default(now()) @map("actualizado_at") @db.Timestamptz

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  barberia  Barberia   @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  /// Servicios que el cliente aceptaría para esa fecha. Relación implícita de
  /// Prisma: la tabla de unión la crea `prisma migrate` y conserva la FK a
  /// `servicios`, así que un servicio eliminado no deja suscripciones huérfanas.
  servicios Servicio[]

  // Búsqueda del matcher del Carril B: cliente + sede + fecha con estado vivo.
  @@index([usuarioId, barberiaId, fechaObjetivo, estado], name: "idx_lista_espera_usuario_fecha")
  @@index([barberiaId, fechaObjetivo, estado], name: "idx_lista_espera_barberia_fecha")
  @@map("lista_esperas")
}

/// V2.1 · Canal de verificación de un código OTP.
///
/// Vía de canal (correo o teléfono) sobre la que se emite el código: `tipo`
/// decide si la salida va por WhatsApp o por correo y además separa la bandera
/// que el código habilita (`telefono_verificado` / `correo_verificado`).
enum TipoOtp {
  TELEFONO
  CORREO
}

/// V3 · quién modificó una excepción de horario del barbero.
///
/// `BARBERO` = el propio dueño del horario; `ADMIN_SEDE` = un administrador
/// de la sede intervino (bloqueo o corrección). Es el ORIGEN del cambio; el
/// usuario concreto se guarda en `modificadoPorId`.
enum OrigenModificacionHorario {
  BARBERO
  ADMIN_SEDE
}

/// V2.1 · Código de verificación de 6 dígitos (10 minutos de vida).
///
/// Un código solo sirve para su usuario y su canal: `tipo` marca qué bandera
/// habilita al validarse. El alta invalida los anteriores no usados del mismo
/// canal —no se borran, se marcan— para que solo haya un código vivo a la vez.
///
/// El código se guarda en claro porque su valor de negocio es un secreto de
/// minutos con una sola lectura; el hash solo serviría para verificar, y aquí
/// hay que REUTILIZARLO para enviarlo. Su protección real es la ventana de 10
/// minutos, el `usado` de un solo disparo y el techo de envíos por minuto.
model OtpConfirmacion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  codigo        String    @db.VarChar(6)
  tipo          TipoOtp
  expiraEn      DateTime  @map("expira_en") @db.Timestamptz
  usado         Boolean   @default(false)
  creadoEn      DateTime? @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime? @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // La validación siempre pregunta por usuario + canal + estado + ventana.
  @@index([usuarioId, tipo, usado, expiraEn], name: "idx_otp_usuario_canal")
  @@map("otp_confirmaciones")
}

/// F7 / T-71 · copia de la cuenta antes de eliminarla de verdad.
///
/// Se escribe cuando el usuario YA no existe, así que `usuario_id` y
/// `eliminado_por` son UUID sueltos SIN relación: una FK a `usuarios` haría
/// imposible insertar el respaldo. La tabla es de solo escritura para el
/// sistema y de solo lectura para auditoría; nunca se borra desde la app.
model RespaldoEliminacion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  snapshot     Json     @db.JsonB
  eliminadoPor String   @map("eliminado_por") @db.Uuid
  eliminadoAt  DateTime @default(now()) @map("eliminado_at") @db.Timestamptz

  @@index([usuarioId], name: "idx_respaldo_eliminacion_usuario")
  @@index([eliminadoAt], name: "idx_respaldo_eliminacion_at")
  @@map("respaldo_eliminacion")
}
