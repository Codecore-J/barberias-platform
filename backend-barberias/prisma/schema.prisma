generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreCompleto     String    @map("nombre_completo") @db.VarChar(150)
  correo             String    @unique @db.VarChar(150)
  // H-02 · el formato (exactamente 10 dígitos) lo impone además PostgreSQL con
  // el CHECK `chk_usuario_telefono_10_digitos` de la migración
  // `add_telefono_check_constraint`. Prisma no sabe expresar CHECKs, así que
  // aquí solo queda la validación del DTO; la garantía real vive en la base.
  telefono           String    @unique @db.VarChar(30)
  cedula             String?   @unique @db.VarChar(30)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  estadoCuenta       String    @default("ACTIVO") @map("estado_cuenta") @db.VarChar(20)
  // E4-03/5 · D24: versión del token. Suspender una cuenta la sube y con eso
  // quedan inválidos los JWT ya firmados (se cierran todas las sesiones).
  tokenVersion       Int       @default(0) @map("token_version")
  // V2.1 · Verificación OTP: el correo y el teléfono se confirman con un código
  // de 6 dígitos antes de poder ocupar agenda (`VerificacionGuard`).
  correoVerificado   Boolean   @default(false) @map("correo_verificado")
  telefonoVerificado Boolean   @default(false) @map("telefono_verificado")
  creadoAt           DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  usuarioRoles           UsuarioRol[]
  barberias              Barberia[]                @relation("Responsable")
  clienteBarberias       ClienteBarberia[]
  reservas               Reserva[]                 @relation("ClienteReserva")
  pagosRegistrados       Pago[]                    @relation("RegistradoPor")
  // H68: quién anuló un cobro (la corrección de §7.3).
  pagosAnulados          Pago[]                    @relation("AnuladoPorPago")
  antecedentes           Antecedente[]
  notificaciones         Notificacion[]
  auditoria              Auditoria[]
  bloqueosCreados        BloqueosAgenda[]          @relation("BloqueoCreador")
  tokensRecuperacion     TokenRecuperacion[]
  horariosBarbero        HorarioBarbero[]          @relation("HorarioDeBarbero")
  excepcionesBarbero     ExcepcionHorarioBarbero[] @relation("ExcepcionDeBarbero")
  // V3 · plantilla semanal recurrente del barbero (independiente de la sede).
  horariosBase           HorarioBaseBarbero[]      @relation("HorarioBaseDeBarbero")
  // F4-03 · propuestas de esa plantilla y las que este usuario resolvió.
  propuestasBasePropias  PropuestaHorarioBase[]    @relation("PropuestaBaseDeBarbero")
  propuestasBaseResueltas PropuestaHorarioBase[]   @relation("PropuestaBaseResueltaPor")
  // F5 · solicitudes de antecedente: quién la pide, sobre quién y quién decide.
  solicitudesAntecedenteSolicitadas SolicitudAntecedente[] @relation("SolicitudAntecedenteSolicitante")
  solicitudesAntecedenteCliente     SolicitudAntecedente[] @relation("SolicitudAntecedenteCliente")
  solicitudesAntecedenteResueltas   SolicitudAntecedente[] @relation("SolicitudAntecedenteResolutor")
  // V3 · excepciones de horario que este usuario modificó (barbero o admin).
  excepcionesEditadas    ExcepcionHorarioBarbero[] @relation("ExcepcionModificadaPor")
  reservasBarbero        Reserva[]                 @relation("BarberoReserva")
  bloqueosBarbero        BloqueosAgenda[]          @relation("BloqueoDeBarbero")
  // E3-08/D17: quién ejecutó la cancelación especial de una reserva.
  reservasCanceladas     Reserva[]                 @relation("CanceladoPorReserva")
  // E3-08/D18: quién creó una propuesta de horario (el CLIENTE dueño).
  propuestasHorario      PropuestaHorario[]
  // E3-13/D26: quién solicitó y quién resolvió un cambio de la sede.
  solicitudesSolicitadas SolicitudCambioBarberia[] @relation("SolicitudSolicitadaPor")
  solicitudesResueltas   SolicitudCambioBarberia[] @relation("SolicitudResueltaPor")
  // E4-02/D22: suscripciones del cliente a huecos que se liberen (Carril B).
  listaEsperas           ListaEspera[]
  // V2.1: códigos OTP de verificación de correo/teléfono.
  otpConfirmaciones      OtpConfirmacion[]
  // V3 · catálogo híbrido: servicios que el propio BARBERO publica en las
  // categorías de la sede.
  serviciosBarbero       ServicioBarbero[]         @relation("ServiciosDeBarbero")
  // V3 fase 6 · caja diaria: quién abrió el turno y quién lo selló.
  cierresCajaAbiertos    CierreCaja[]              @relation("CierreAbiertoPor")
  cierresCajaCerrados    CierreCaja[]              @relation("CierreCerradoPor")
  // T-27 · solicitudes de servicio: quién las pidió y quién las resolvió.
  solicitudesServicioPropias  SolicitudServicioBarbero[] @relation("SolicitudServicioDeBarbero")
  solicitudesServicioResueltas SolicitudServicioBarbero[] @relation("SolicitudServicioResueltaPor")

  @@map("usuarios")
}

model Rol {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre String @unique @db.VarChar(50)
  ambito String @db.VarChar(20)

  rolPermisos  RolPermiso[]
  usuarioRoles UsuarioRol[]

  @@map("roles")
}

model Permiso {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String  @unique @db.VarChar(100)
  descripcion String? @db.Text

  rolPermisos RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model UsuarioRol {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String  @map("usuario_id") @db.Uuid
  rolId      String  @map("rol_id") @db.Uuid
  barberiaId String? @map("barberia_id") @db.Uuid
  estado     String  @default("ACTIVO") @db.VarChar(20)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol      Rol       @relation(fields: [rolId], references: [id])
  // CASCADE, no SET NULL: una asignación de ámbito sede sin sede no significa
  // nada. Con la regla por defecto de una relación opcional, borrar una sede
  // dejaba filas con `barberia_id = NULL` que ni dan acceso (`alcanceCumple`
  // exige `ambito = GLOBAL`) ni se limpian solas. Las filas globales
  // (`barberia_id IS NULL`) no se tocan: no coinciden con ninguna sede.
  barberia Barberia? @relation(fields: [barberiaId], references: [id], onDelete: Cascade)

  // E0 · la unicidad NO se declara aquí. Un `@@unique` con `barberiaId`
  // nullable no protege los roles globales: PostgreSQL considera distintos dos
  // NULL, así que `(usuario, rol, NULL)` se podía insertar sin límite (de ahí
  // los roles duplicados en el JWT). La garantía real vive en dos índices
  // únicos PARCIALES de la migración `fix_indexes_and_roles`:
  //   uk_usuario_rol_global → (usuario_id, rol_id) WHERE barberia_id IS NULL
  //   uk_usuario_rol_sede   → (usuario_id, rol_id, barberia_id) WHERE barberia_id IS NOT NULL
  // Prisma no sabe expresar índices parciales; por eso no aparecen aquí.
  @@map("usuario_roles")
}

model Barberia {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  // H-02 · formato de 10 dígitos garantizado además por PostgreSQL con el CHECK
  // `chk_barberia_telefono_10_digitos` (migración `add_barberias_telefono_check`).
  // Prisma no expresa CHECKs: `CreateBarberiaDto`/`UpdateBarberiaDto` validan
  // primero y esta restricción cubre cualquier escritura que los esquive.
  telefono      String    @db.VarChar(30)
  ubicacion     String    @db.Text
  // F6 / T-60 · ubicación geográfica de la sede. Coordenadas y divisiones
  // político-administrativas llegan con la migración `f601_ubicacion_sede` y
  // son NULLABLES a propósito: las sedes anteriores se crearon sin
  // coordenadas y no se rellenan con un punto inventado. La obligatoriedad es
  // del alta (T-62, `CreateBarberiaDto`), no de la columna: así una sede
  // histórica sigue siendo válida y la migración no rompe filas existentes.
  // `Decimal(10,7)` da ~1 cm de precisión, suficiente para una dirección.
  latitud       Decimal?  @db.Decimal(10, 7)
  longitud      Decimal?  @db.Decimal(10, 7)
  // ISO 3166-1 alpha-2 en mayúsculas (`DO`). Nominatim lo devuelve en
  // minúsculas; el servicio lo normaliza (T-61).
  paisCodigo    String?   @map("pais_codigo") @db.VarChar(2)
  // División 1 = provincia, división 2 = municipio (República Dominicana).
  // Se guarda el texto que devuelve Nominatim; el catálogo de T-65 permite
  // ofrecerlo como select sin inventar nombres.
  divisionNivel1 String?  @map("division_nivel1") @db.VarChar(100)
  divisionNivel2 String?  @map("division_nivel2") @db.VarChar(100)
  // `display_name` de Nominatim truncado a 300 caracteres (T-62).
  direccionCompleta String? @map("direccion_completa") @db.VarChar(300)
  codigoAcceso  String    @unique @map("codigo_acceso") @db.VarChar(50)
  enlaceUnico   String    @unique @map("enlace_unico") @db.VarChar(100)
  responsableId String    @map("responsable_id") @db.Uuid
  estado        String    @default("ACTIVO") @db.VarChar(20)
  // E2-04 / D15: zona horaria de la sede. Las fechas y horas de cita
  // (`fecha_cita`, `hora_inicio`, `hora_fin`) son ETIQUETAS locales a esta zona
  // y los instantes (`expira_at`, `creado_at`) son UTC. La columna llega con la
  // migración `e204_zona_horaria`; E2-03 la dejará con su CHECK (D15).
  zonaHoraria   String    @default("America/Santo_Domingo") @map("zona_horaria") @db.VarChar(50)
  // E3-13: el logo es edición directa de la sede (junto a descripción y
  // ubicación); el nombre y el responsable solo cambian por solicitud aprobada.
  // `Text` (no `VarChar(500)`) porque `dev` ya tenía la columna como `text`
  // cuando llegó E3-13: la migración la declara idempotente y así el esquema y
  // la base coinciden también en bases creadas desde cero. Ver H50.
  logoUrl       String?   @map("logo_url") @db.Text
  // F6 / T-64 · `public_id` de Cloudinary del logo. Sin él, reemplazar el logo
  // solo podría deducir el id desde la URL (posible, pero frágil) y el archivo
  // anterior quedaría huérfano en cada cambio. La columna llega con la
  // migración `f604_logo_public_id_sede`, idempotente como la de `logo_url`.
  logoPublicId  String?   @map("logo_public_id") @db.VarChar(255)
  // E2-03: alta de la sede. La crea la migración reconstruida
  // `20261011130000_e203_integridad_base`; en `dev` ya existía (H50).
  creadoAt      DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  responsable Usuario @relation("Responsable", fields: [responsableId], references: [id])

  usuarioRoles          UsuarioRol[]
  auditorias            Auditoria[]
  clienteBarberias      ClienteBarberia[]
  servicios             Servicio[]
  // V3 · catálogo híbrido: las categorías las crea el ADMIN_BARBERIA de la sede
  // y los barberos publican sus servicios dentro de ellas.
  categoriasServicio    CategoriaServicio[]
  // T-20 · servicios del barbero publicados EN esta sede (la categoría ya es
  // global, así que la sede del servicio vive en `servicios_barbero`).
  serviciosBarberoSede  ServicioBarbero[]         @relation("ServiciosBarberoDeSede")
  combos                Combo[]
  horarios              Horario[]
  excepcionesHorario    ExcepcionHorario[]
  bloqueosAgenda        BloqueosAgenda[]
  reservas              Reserva[]
  antecedentesOrigen    Antecedente[]             @relation("BarberiaOrigen")
  reportes              Reporte[]
  configuracionBarberia ConfiguracionBarberia?
  horariosBarbero       HorarioBarbero[]
  excepcionesBarbero    ExcepcionHorarioBarbero[]
  solicitudesCambio     SolicitudCambioBarberia[]
  // V3 fase 6 · caja: los cobros pertenecen a la SEDE (no solo a su reserva),
  // así el arqueo diario no depende de recorrer reservas.
  pagos                 Pago[]
  cierresCaja           CierreCaja[]
  // E4-02/D22: clientes esperando un hueco liberado en esta sede y fecha.
  listaEsperas          ListaEspera[]
  // T-27 · solicitudes de servicio de los barberos de esta sede.
  solicitudesServicio   SolicitudServicioBarbero[]
  // F4-03 · propuestas de plantilla base que esta sede debe resolver.
  propuestasHorarioBase PropuestaHorarioBase[]
  // F5 · solicitudes de antecedente de esta sede.
  solicitudesAntecedente SolicitudAntecedente[]

  @@map("barberias")
}

/// F6 / T-65 · catálogo de divisiones administrativas (provincia y municipio).
///
/// Nominatim devuelve nombres, no códigos: esta tabla es la referencia que
/// permite ofrecerlos como select y emparejar lo que llega del proveedor aunque
/// su escritura no coincida exactamente (`nombre_nominatim`).
model DivisionAdministrativa {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paisCodigo      String  @map("pais_codigo") @db.VarChar(2)
  /// 1 = provincia, 2 = municipio (CHECK en la migración `f605`).
  nivel           Int
  nombre          String  @db.VarChar(100)
  /// Cómo llama Nominatim a esta división, si difiere del nombre oficial.
  nombreNominatim String? @map("nombre_nominatim") @db.VarChar(100)
  padreId         String? @map("padre_id") @db.Uuid

  padre     DivisionAdministrativa?  @relation("JerarquiaDivision", fields: [padreId], references: [id])
  hijos     DivisionAdministrativa[] @relation("JerarquiaDivision")

  /// Misma clave que el índice único `uk_divisiones_pais_nivel_nombre`: es lo
  /// que hace idempotente el seed de T-65.
  @@unique([paisCodigo, nivel, nombre], map: "uk_divisiones_pais_nivel_nombre")
  @@index([padreId], map: "idx_divisiones_padre")
  @@map("divisiones_administrativas")
}

model ClienteBarberia {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId            String    @map("usuario_id") @db.Uuid
  barberiaId           String    @map("barberia_id") @db.Uuid
  estadoVinculacion    String    @default("ACTIVO") @map("estado_vinculacion") @db.VarChar(20)
  esBarberiaActiva     Boolean   @default(false) @map("es_barberia_activa")
  contadorNoPresentado Int       @default(0) @map("contador_no_presentado")
  estaRestringido      Boolean   @default(false) @map("esta_restringido")
  motivoRestriccion    String?   @map("motivo_restriccion") @db.Text
  creadoAt             DateTime? @default(now()) @map("creado_at") @db.Timestamptz

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  barberia Barberia @relation(fields: [barberiaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, barberiaId], name: "uk_cliente_barberia")
  @@map("cliente_barberias")
}

model Servicio {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId       String  @map("barberia_id") @db.Uuid
  nombre           String  @db.VarChar(100)
  // T-22 (23 nov 2026): la descripción volvió al catálogo de la sede (DEF-03).
  // Es opcional, texto libre y con tope de 500; el panel la edita y el cliente
  // la lee en la vitrina.
  descripcion      String? @db.VarChar(500)
  precio           Decimal @db.Decimal(10, 2)
  duracionEstimada Int     @map("duracion_estimada")
  margenOperativo  Int     @default(0) @map("margen_operativo")
  destacado        Boolean @default(false)
  estado           String  @default("ACTIVO") @db.VarChar(20)

  barberia              Barberia               @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  comboItems            ComboItem[]
  participanteServicios ParticipanteServicio[]
  // E4-02/D22: suscripciones de lista de espera que piden este servicio.
  listaEsperas          ListaEspera[]

  // E0 · el catálogo se lista siempre por sede.
  @@index([barberiaId])
  @@map("servicios")
}

/// V3 · categoría de servicio GLOBAL de la plataforma (nomenclatura del negocio).
///
/// T-20 (23 nov 2026): la taxonomía dejó de ser de cada sede. `barberia_id`
/// admite NULL y ese NULL significa «global»: el ADMINISTRADOR define una vez
/// (Corte, Barba, Color...) y las sedes publican dentro de esas categorías. Antes
/// cada sede tenía su propia copia del mismo nombre —en producción había 33
/// filas para 11 nombres— y renombrar una no cambiaba las demás.
///
/// El nombre es único en TODO el catálogo (normalizado a minúsculas y sin
/// espacios sobrantes): dos «Corte» en sedes distintas vuelven a ser dos
/// categorías distintas para el cliente. `orden` decide el orden de presentación
/// y la categoría nunca se borra (§9): se desactiva con `activa = false`.
///
/// La columna `barberia_id` se conserva porque la migración de T-20 necesita
/// saber de qué sede salió cada fila; las categorías vivas la llevan en NULL.
model CategoriaServicio {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId    String?  @map("barberia_id") @db.Uuid
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.Text
  activa        Boolean  @default(true)
  orden         Int      @default(0)
  creadoAt      DateTime @default(now()) @map("creado_at") @db.Timestamptz
  actualizadoAt DateTime @default(now()) @updatedAt @map("actualizado_at") @db.Timestamptz

  barberia  Barberia?         @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  servicios ServicioBarbero[]

  // La unicidad GLOBAL del nombre vive SOLO en la base, en el índice
  // `uk_categoria_global_nombre`, que es de EXPRESIÓN
  // (`lower(btrim(regexp_replace(nombre, '\s+', ' ', 'g')))`) para que «Corte» y
  // «corte  » sean la misma categoría. Prisma no sabe modelar un índice de
  // expresión: declararlo aquí como `@unique` mentiría y cualquier `upsert`
  // emitiría `ON CONFLICT (nombre)`, que PostgreSQL rechaza con 42P10. Por eso
  // el código resuelve el nombre con `findFirst` (como `CategoriasService`) y no
  // con `upsert`. Ver la migración 20261123170000_categorias_globales.
  @@map("categorias_servicio")
}

/// V3 · servicio que un BARBERO publica dentro de una categoría de la sede.
///
/// Es el catálogo «híbrido»: la categoría es del negocio, el nombre, el precio y
/// la duración son del barbero (`nombrePersonalizado`). La fila no se borra, se
/// desactiva con `activo = false` (§9), y las reservas ya confirmadas no dependen
/// de ella porque guardan su snapshot en `participante_servicios`.
model ServicioBarbero {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoriaId         String   @map("categoria_id") @db.Uuid
  barberoId           String   @map("barbero_id") @db.Uuid
  // T-20 (23 nov 2026): la categoría pasó a ser global, así que ya no identifica
  // la sede. El servicio sigue siendo DE UNA SEDE y esa sede se guarda aquí; sin
  // esta columna, el catálogo de un barbero con rol en dos sedes se mezclaría.
  barberiaId          String   @map("barberia_id") @db.Uuid
  nombrePersonalizado String   @map("nombre_personalizado") @db.VarChar(100)
  // T-23 (24 nov 2026): descripción opcional del servicio, 500 caracteres como
  // en `servicios`. Vacía se guarda como NULL (no como cadena en blanco).
  descripcion         String?  @db.VarChar(500)
  // T-24 (24 nov 2026): URL pública de la foto del servicio en Cloudinary. El
  // archivo no se guarda en la base; solo su URL (migración idempotente).
  imagenUrl           String?  @map("imagen_url") @db.VarChar(500)
  // 24 nov 2026: `public_id` de Cloudinary de esa misma foto. Se guarda aparte
  // para borrar el reemplazo con el identificador exacto, sin deducirlo de la
  // URL. Las filas anteriores quedan en NULL y se borran por la URL.
  imagenPublicId      String?  @map("imagen_public_id") @db.VarChar(255)
  precio              Decimal  @db.Decimal(10, 2)
  duracionMinutos     Int      @map("duracion_minutos")
  activo              Boolean  @default(true)
  creadoAt            DateTime @default(now()) @map("creado_at") @db.Timestamptz
  actualizadoAt       DateTime @default(now()) @updatedAt @map("actualizado_at") @db.Timestamptz

  // RESTRICT en la categoría: si algún día se intentara un borrado real de una
  // categoría con servicios, la integridad referencial lo impide. El camino
  // normal es desactivarla (`activa = false`).
  categoria CategoriaServicio @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  barbero   Usuario           @relation("ServiciosDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)
  barberia  Barberia          @relation("ServiciosBarberoDeSede", fields: [barberiaId], references: [id], onDelete: Cascade)

  // V3 fase 4 · snapshot de las reservas creadas con este servicio: la otra
  // mitad del vínculo opcional de `participante_servicios`.
  participanteServicios ParticipanteServicio[]
  // T-27 · solicitudes de desactivación que apuntan a este servicio.
  solicitudesServicio   SolicitudServicioBarbero[]

  @@unique([barberoId, categoriaId, nombrePersonalizado], name: "uk_servicio_barbero_categoria_nombre", map: "uk_servicio_barbero_categoria_nombre")
  @@index([categoriaId, activo], name: "idx_servicios_barbero_categoria")
  @@index([barberoId, activo], name: "idx_servicios_barbero_barbero")
  @@index([barberiaId, activo], name: "idx_servicios_barbero_sede")
  @@map("servicios_barbero")
}

/// T-27 (24 nov 2026) · solicitud de servicio de un BARBERO.
///
/// El barbero pide publicar un servicio (`ALTA`) o retirar uno ya publicado
/// (`DESACTIVACION`); el ADMIN_BARBERIA de la sede la resuelve. Nada se borra:
/// el estado (`PENDIENTE`, `APROBADA`, `RECHAZADA`) y el motivo del rechazo
/// quedan como historial de la petición.
///
/// Aprobar un alta crea el servicio en `Servicio` —el catálogo de la sede— y
/// habilita al solicitante en `ServicioBarbero` con su precio (decisión del
/// 23 nov). Por eso la solicitud guarda los datos del servicio y no solo una
/// referencia.
model SolicitudServicioBarbero {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberiaId          String    @map("barberia_id") @db.Uuid
  barberoId           String    @map("barbero_id") @db.Uuid
  tipo                String    @db.VarChar(20)
  estado              String    @default("PENDIENTE") @db.VarChar(20)
  categoriaId         String?   @map("categoria_id") @db.Uuid
  nombrePersonalizado String?   @map("nombre_personalizado") @db.VarChar(100)
  descripcion         String?   @db.VarChar(500)
  imagenUrl           String?   @map("imagen_url") @db.VarChar(500)
  imagenPublicId      String?   @map("imagen_public_id") @db.VarChar(255)
  precio              Decimal?  @db.Decimal(10, 2)
  duracionMinutos     Int?      @map("duracion_minutos")
  // Solo en `DESACTIVACION`: el servicio publicado que se pide retirar.
  servicioId          String?   @map("servicio_id") @db.Uuid
  motivoRechazo       String?   @map("motivo_rechazo") @db.VarChar(500)
  resueltoPor         String?   @map("resuelto_por") @db.Uuid
  resueltaAt          DateTime? @map("resuelta_at") @db.Timestamptz
  creadoAt            DateTime  @default(now()) @map("creado_at") @db.Timestamptz
  actualizadoAt       DateTime  @default(now()) @updatedAt @map("actualizado_at") @db.Timestamptz

  barberia        Barberia        @relation(fields: [barberiaId], references: [id], onDelete: Cascade)
  barbero         Usuario         @relation("SolicitudServicioDeBarbero", fields: [barberoId], references: [id], onDelete: Cascade)
  resolutor       Usuario?        @relation("SolicitudServicioResueltaPor", fields: [resueltoPor], references: [id], onDelete: SetNull)
  servicioBarbero ServicioBarbero? @relation(fields: [servicioId], references: [id], onDelete: SetNull)

  // Los CHECK de estado, tipo y motivo viven en la migración.
  @@index([barberiaId, estado], name: "idx_solicitudes_servicio_sede_estado")
  @@index([barberoId, estado], name: "idx_solicitudes_servicio_barbero")
  @@map("solicitudes_servicio_barbero")
}

