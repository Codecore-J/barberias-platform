{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/generate-runtime-env.mjs && ng build",
  "outputDirectory": "dist/frontend-barberias/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://barberias-api-p3br.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
